# NMTC Platform Environment Configuration
# Copy this file to .env and update with your actual values

# AI Provider Configuration
# Options: openai, azure_openai
AI_PROVIDER=openai

# OpenAI Configuration (for development/MVP)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=org-your-org-id-optional

# Azure OpenAI Configuration (for enterprise production)
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_VERSION=2024-02-01

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Azure Document Intelligence (OCR)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-di-key

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/nmtc_db

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
MAX_CONCURRENT_JOBS=5
DEFAULT_JOB_TIMEOUT_MINUTES=30

# Security
JWT_SECRET_KEY=your-jwt-secret-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# File Storage
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=.pdf,.docx

# Enterprise Features
ENABLE_WORKFLOW_ORCHESTRATION=True
ENABLE_JOB_RECOVERY=True
ENABLE_PERFORMANCE_METRICS=True